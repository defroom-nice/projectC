{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 构建多文件猜数字游戏",
            "command": "C:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c11",
                "${workspaceFolder}\\abc.c",
                "${workspaceFolder}\\game.c",
                "${workspaceFolder}\\input.c",
                "-o",
                "${workspaceFolder}\\game.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "构建由 abc.c、game.c 和 input.c 组成的多文件猜数字游戏。"
        }
    ],
    "version": "2.0.0"
}